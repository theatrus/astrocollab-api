{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/MetricRule.schema.json",
  "title": "MetricRule",
  "type": "object",
  "required": [
    "metric",
    "method",
    "method_version",
    "unit",
    "required"
  ],
  "properties": {
    "metric": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "method": {
      "$ref": "Text.schema.json"
    },
    "method_version": {
      "$ref": "Text.schema.json"
    },
    "unit": {
      "$ref": "Text.schema.json"
    },
    "required": {
      "type": "boolean"
    },
    "min_value": {
      "type": "number"
    },
    "max_value": {
      "type": "number"
    }
  },
  "anyOf": [
    {
      "required": [
        "min_value"
      ]
    },
    {
      "required": [
        "max_value"
      ]
    }
  ],
  "additionalProperties": false
}
