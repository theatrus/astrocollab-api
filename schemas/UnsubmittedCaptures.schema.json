{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/UnsubmittedCaptures.schema.json",
  "title": "UnsubmittedCaptures",
  "type": "object",
  "required": [
    "panel_id",
    "frames",
    "integration_seconds"
  ],
  "properties": {
    "panel_id": {
      "$ref": "Uuid.schema.json"
    },
    "frames": {
      "type": "integer",
      "minimum": 0
    },
    "integration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "last_captured_at": {
      "$ref": "Timestamp.schema.json",
      "description": "When the most recent of these frames was captured."
    }
  },
  "description": "Frames captured for one panel and not yet submitted.",
  "additionalProperties": false
}
