{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Assignment.schema.json",
  "title": "Assignment",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "project_revision",
    "created_at",
    "expires_at",
    "panels"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "project_id": {
      "$ref": "Uuid.schema.json"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "The requirements revision the frames will be judged against."
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    },
    "expires_at": {
      "$ref": "Timestamp.schema.json",
      "description": "Stop starting new frames for this assignment after this time."
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "Panel.schema.json"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "estimated_rig_seconds": {
      "type": "number",
      "minimum": 0
    },
    "estimated_accepted_integration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "Text.schema.json"
      },
      "minItems": 0,
      "maxItems": 16,
      "description": "Plain notes for the user, such as why a target was chosen."
    }
  },
  "description": "What a rig should image: the panels the server hands out, in order. Image the first;\nmove to the next when it has its suggested frames or can no longer be imaged.",
  "additionalProperties": false
}
