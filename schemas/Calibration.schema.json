{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Calibration.schema.json",
  "title": "Calibration",
  "type": "object",
  "required": [
    "calibration_frames",
    "steps",
    "pixel_unit",
    "linear",
    "color_state",
    "registration"
  ],
  "properties": {
    "raw_sha256": {
      "$ref": "Sha256.schema.json",
      "description": "SHA-256 of the raw frame. Required for calibrated subs; omitted for stacked masters."
    },
    "calibration_frames": {
      "type": "array",
      "items": {
        "$ref": "CalibrationFrame.schema.json"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "CalibrationStep.schema.json"
      },
      "minItems": 1,
      "maxItems": 32
    },
    "pixel_unit": {
      "type": "string",
      "enum": [
        "adu",
        "electrons",
        "normalized"
      ]
    },
    "adu_scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "linear": {
      "type": "boolean"
    },
    "color_state": {
      "type": "string",
      "enum": [
        "mono",
        "cfa",
        "debayered_rgb"
      ]
    },
    "registration": {
      "type": "string",
      "enum": [
        "unregistered",
        "registered"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pixel_unit": {
            "const": "normalized"
          }
        }
      },
      "then": {
        "required": [
          "adu_scale"
        ]
      }
    }
  ],
  "additionalProperties": false
}
