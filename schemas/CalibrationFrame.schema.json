{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/CalibrationFrame.schema.json",
  "title": "CalibrationFrame",
  "type": "object",
  "required": [
    "role",
    "sha256"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "bias",
        "dark",
        "flat",
        "dark_flat"
      ]
    },
    "sha256": {
      "$ref": "Sha256.schema.json"
    }
  },
  "description": "A calibration frame used on a sub: its role and hash. The frame itself is never sent.",
  "additionalProperties": false
}
