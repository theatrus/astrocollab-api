{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/PairRequest.schema.json",
  "title": "PairRequest",
  "type": "object",
  "required": [
    "code",
    "name"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "The single-use code the person issued."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "What to call this telescope."
    }
  },
  "description": "Trade a pairing code from the server's web pages for a telescope token."
}
