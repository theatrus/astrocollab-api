{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/SubmissionCreate.schema.json",
  "title": "SubmissionCreate",
  "type": "object",
  "required": [
    "id",
    "project_revision",
    "artifacts"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "ArtifactManifest.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "description": "A batch of files for one project. The client picks the `id`; repeating it returns the existing submission.",
  "additionalProperties": false
}
