{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/SolveEvidence.schema.json",
  "title": "SolveEvidence",
  "type": "object",
  "required": [
    "source",
    "artifact_sha256",
    "center",
    "method",
    "method_version",
    "measured_at"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "fresh_pixel_solve",
        "embedded_wcs"
      ]
    },
    "artifact_sha256": {
      "$ref": "Sha256.schema.json"
    },
    "center": {
      "$ref": "Position.schema.json"
    },
    "method": {
      "$ref": "Text.schema.json"
    },
    "method_version": {
      "$ref": "Text.schema.json"
    },
    "measured_at": {
      "$ref": "Timestamp.schema.json"
    }
  },
  "additionalProperties": false
}
