{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Terms.schema.json",
  "title": "Terms",
  "type": "object",
  "required": [
    "id",
    "version",
    "url",
    "sha256"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "url": {
      "$ref": "HttpsUrl.schema.json"
    },
    "sha256": {
      "$ref": "Sha256.schema.json"
    }
  },
  "additionalProperties": false
}
