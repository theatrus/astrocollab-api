{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/PanelLayout.schema.json",
  "title": "PanelLayout",
  "type": "object",
  "required": [
    "columns",
    "rows",
    "column",
    "row"
  ],
  "properties": {
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "column": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "row": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "description": "A panel's place in the grid the server laid over a target. Columns run east to west.",
  "additionalProperties": false
}
