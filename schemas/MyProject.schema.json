{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/MyProject.schema.json",
  "title": "MyProject",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "state",
    "membership"
  ],
  "properties": {
    "project_id": {
      "$ref": "Uuid.schema.json"
    },
    "title": {
      "$ref": "Text.schema.json"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "paused",
        "closed"
      ]
    },
    "membership": {
      "type": "string",
      "enum": [
        "requested",
        "active",
        "paused",
        "withdrawn",
        "revoked"
      ],
      "description": "Only `active` members can submit or receive assignments."
    }
  },
  "description": "A project the account has joined, and the account's standing in it.",
  "additionalProperties": false
}
