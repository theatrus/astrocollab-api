{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/ProcessingGroup.schema.json",
  "title": "ProcessingGroup",
  "type": "object",
  "required": [
    "id",
    "name",
    "sampling_arcsec_per_pixel",
    "color_state",
    "registration",
    "linear",
    "required_calibration_steps"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "name": {
      "$ref": "Text.schema.json"
    },
    "sampling_arcsec_per_pixel": {
      "$ref": "Range.schema.json"
    },
    "color_state": {
      "type": "string",
      "enum": [
        "mono",
        "cfa",
        "debayered_rgb"
      ]
    },
    "registration": {
      "type": "string",
      "enum": [
        "unregistered",
        "registered"
      ]
    },
    "linear": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "required_calibration_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bias_subtract",
          "dark_subtract",
          "flat_correct",
          "dark_flat_correct"
        ]
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "additionalProperties": false
}
