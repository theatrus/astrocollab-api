{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Range.schema.json",
  "title": "Range",
  "type": "object",
  "required": [
    "min",
    "max"
  ],
  "properties": {
    "min": {
      "type": "number",
      "minimum": 0
    },
    "max": {
      "type": "number",
      "minimum": 0
    }
  },
  "description": "Inclusive range. Server MUST enforce min <= max.",
  "additionalProperties": false
}
