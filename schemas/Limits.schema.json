{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Limits.schema.json",
  "title": "Limits",
  "type": "object",
  "required": [
    "max_json_bytes",
    "max_artifacts_per_submission",
    "max_artifact_bytes",
    "max_chunk_bytes",
    "upload_staging_seconds",
    "max_decoded_pixels"
  ],
  "properties": {
    "max_json_bytes": {
      "type": "integer",
      "minimum": 1024
    },
    "max_artifacts_per_submission": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_artifact_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_chunk_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "upload_staging_seconds": {
      "type": "integer",
      "minimum": 3600
    },
    "max_decoded_pixels": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
