{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Objective.schema.json",
  "title": "Objective",
  "type": "object",
  "required": [
    "id",
    "target_id",
    "processing_group_id",
    "bandpasses",
    "purpose",
    "exposure",
    "goal",
    "minimum_coverage_fraction",
    "fresh_pixel_solve",
    "quality_rules",
    "required_features"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "target_id": {
      "$ref": "Uuid.schema.json"
    },
    "processing_group_id": {
      "$ref": "Uuid.schema.json"
    },
    "bandpasses": {
      "type": "array",
      "items": {
        "$ref": "Bandpass.schema.json"
      },
      "minItems": 1,
      "maxItems": 8,
      "description": "Accepted passbands. A frame qualifies when one of its passbands matches one of these."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "deep",
        "short_dynamic_range",
        "continuum",
        "other"
      ]
    },
    "exposure": {
      "$ref": "ExposureRange.schema.json"
    },
    "goal": {
      "$ref": "Goal.schema.json"
    },
    "minimum_coverage_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fresh_pixel_solve": {
      "type": "boolean"
    },
    "quality_rules": {
      "type": "array",
      "items": {
        "$ref": "MetricRule.schema.json"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "required_features": {
      "type": "array",
      "items": {
        "$ref": "FeatureName.schema.json"
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "additionalProperties": false
}
