{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Site.schema.json",
  "title": "Site",
  "type": "object",
  "required": [
    "latitude_degrees",
    "longitude_degrees",
    "precision_km",
    "timezone"
  ],
  "properties": {
    "latitude_degrees": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude_degrees": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "precision_km": {
      "type": "number",
      "minimum": 0
    },
    "timezone": {
      "$ref": "Text.schema.json"
    }
  },
  "additionalProperties": false
}
