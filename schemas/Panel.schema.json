{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Panel.schema.json",
  "title": "Panel",
  "type": "object",
  "required": [
    "id",
    "target_id",
    "objective_ids",
    "footprint",
    "overlap_fraction",
    "equipment",
    "filter_id",
    "exposure_seconds",
    "suggested_frames"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "target_id": {
      "$ref": "Uuid.schema.json"
    },
    "target_name": {
      "$ref": "Text.schema.json",
      "description": "The target's name, for display."
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "$ref": "Uuid.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "footprint": {
      "$ref": "Footprint.schema.json",
      "description": "The camera field to point at: center, size and angle. It fits the rig's field of view."
    },
    "layout": {
      "$ref": "PanelLayout.schema.json",
      "description": "Where this panel sits when the server splits the target into a grid."
    },
    "overlap_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.9
    },
    "equipment": {
      "$ref": "EquipmentRef.schema.json"
    },
    "filter_id": {
      "$ref": "Uuid.schema.json"
    },
    "exposure_seconds": {
      "type": "number",
      "maximum": 86400,
      "exclusiveMinimum": 0
    },
    "suggested_frames": {
      "type": "integer",
      "minimum": 1
    }
  },
  "description": "One field to image: where to point, which filter, how long and how many frames.",
  "additionalProperties": false
}
