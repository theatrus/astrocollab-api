{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Stack.schema.json",
  "title": "Stack",
  "type": "object",
  "required": [
    "sub_count",
    "integration_seconds",
    "first_captured_at",
    "last_captured_at",
    "subs",
    "registration",
    "normalization",
    "rejection",
    "weighting",
    "software",
    "version"
  ],
  "properties": {
    "sub_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "integration_seconds": {
      "type": "number",
      "description": "Total exposure of the subs: `sub_count` × `exposure_seconds`.",
      "exclusiveMinimum": 0
    },
    "first_captured_at": {
      "$ref": "Timestamp.schema.json"
    },
    "last_captured_at": {
      "$ref": "Timestamp.schema.json"
    },
    "subs": {
      "type": "array",
      "items": {
        "$ref": "StackedSub.schema.json"
      },
      "minItems": 1,
      "maxItems": 5000,
      "description": "Every sub in the master. A sub may appear in only one credited master or sub."
    },
    "registration": {
      "$ref": "Text.schema.json",
      "description": "For example \"star alignment, Lanczos-3\"."
    },
    "normalization": {
      "$ref": "Text.schema.json",
      "description": "For example \"additive with scaling\"."
    },
    "rejection": {
      "$ref": "Text.schema.json",
      "description": "For example \"winsorized sigma clip, 3.0/3.0\"."
    },
    "weighting": {
      "$ref": "Text.schema.json",
      "description": "For example \"PSF signal weight\"."
    },
    "drizzle_scale": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "description": "Present when the master was drizzled."
    },
    "software": {
      "$ref": "Text.schema.json"
    },
    "version": {
      "$ref": "Text.schema.json"
    }
  },
  "description": "Provenance of a stacked master.",
  "additionalProperties": false
}
