{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Project.schema.json",
  "title": "Project",
  "type": "object",
  "required": [
    "id",
    "title",
    "state",
    "revision",
    "published_at",
    "requirements"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "title": {
      "$ref": "Text.schema.json"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "paused",
        "closed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Rises each time the owners publish new requirements. Submissions cite it."
    },
    "published_at": {
      "$ref": "Timestamp.schema.json"
    },
    "requirements": {
      "$ref": "RequirementSet.schema.json"
    }
  },
  "description": "A project and its current requirements.",
  "additionalProperties": false
}
