{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/JoinResponse.schema.json",
  "title": "JoinResponse",
  "type": "object",
  "required": [
    "task",
    "requirements"
  ],
  "properties": {
    "task": {
      "anyOf": [
        {
          "$ref": "Task.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "requirements": {
      "$ref": "Requirements.schema.json"
    },
    "alreadyJoined": {
      "type": "boolean",
      "description": "The rig already held a share; that one is returned."
    }
  }
}
