{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/EquipmentInput.schema.json",
  "title": "EquipmentInput",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "$ref": "Text.schema.json"
    },
    "sensor_width_pixels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000,
      "description": "Unbinned sensor size. Field of view does not depend on binning; sampling does."
    },
    "sensor_height_pixels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "pixel_size_um": {
      "type": "number",
      "maximum": 1000,
      "exclusiveMinimum": 0
    },
    "focal_length_mm": {
      "type": "number",
      "maximum": 100000,
      "exclusiveMinimum": 0
    },
    "binning_x": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "Defaults to 1."
    },
    "binning_y": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "description": "Defaults to 1."
    },
    "color_state": {
      "type": "string",
      "enum": [
        "mono",
        "cfa",
        "debayered_rgb"
      ]
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "Filter.schema.json"
      },
      "minItems": 1,
      "maxItems": 100,
      "description": "Filters the rig can use. A color camera with no filter lists one `kind: none` filter."
    },
    "camera": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "telescope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "rotation": {
      "type": "string",
      "enum": [
        "fixed",
        "manual",
        "motorized"
      ],
      "description": "Defaults to `fixed`."
    },
    "confirmed_position_angle_degrees": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "site": {
      "$ref": "Site.schema.json"
    },
    "extensions": {
      "type": "object",
      "unevaluatedProperties": {},
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    }
  },
  "description": "A rig's description. Only `name` is required: the user may enter some details on the\nserver's web pages and the rig others. To plan for a rig, the server needs the sensor\nsize, pixel size, focal length, color state and at least one filter; until then,\ncheck-ins return `review_required` with reason `rig_incomplete`.",
  "additionalProperties": false
}
