{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Submission.schema.json",
  "title": "Submission",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "project_revision",
    "state",
    "created_at",
    "manifest",
    "uploads",
    "artifacts"
  ],
  "properties": {
    "id": {
      "$ref": "Uuid.schema.json"
    },
    "project_id": {
      "$ref": "Uuid.schema.json"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "uploading",
        "processing",
        "complete"
      ]
    },
    "created_at": {
      "$ref": "Timestamp.schema.json"
    },
    "manifest": {
      "$ref": "SubmissionCreate.schema.json"
    },
    "uploads": {
      "type": "array",
      "items": {
        "$ref": "UploadSession.schema.json"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "ArtifactResult.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "additionalProperties": false
}
