{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/Footprint.schema.json",
  "title": "Footprint",
  "type": "object",
  "required": [
    "center",
    "width_degrees",
    "height_degrees",
    "position_angle_degrees"
  ],
  "properties": {
    "center": {
      "$ref": "Position.schema.json"
    },
    "width_degrees": {
      "type": "number",
      "maximum": 30,
      "exclusiveMinimum": 0
    },
    "height_degrees": {
      "type": "number",
      "maximum": 30,
      "exclusiveMinimum": 0
    },
    "position_angle_degrees": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    }
  },
  "additionalProperties": false
}
