{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theatrus.github.io/astrocollab-api/schemas/RequirementSet.schema.json",
  "title": "RequirementSet",
  "type": "object",
  "required": [
    "title",
    "description",
    "targets",
    "processing_groups",
    "objectives",
    "terms",
    "capture_deadline",
    "submission_deadline",
    "required_features",
    "deliverable"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "$ref": "Text.schema.json"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "Target.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "processing_groups": {
      "type": "array",
      "items": {
        "$ref": "ProcessingGroup.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "Objective.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "terms": {
      "$ref": "Terms.schema.json"
    },
    "capture_deadline": {
      "$ref": "Timestamp.schema.json"
    },
    "submission_deadline": {
      "$ref": "Timestamp.schema.json"
    },
    "required_features": {
      "type": "array",
      "items": {
        "$ref": "FeatureName.schema.json"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "deliverable": {
      "type": "string",
      "enum": [
        "calibrated_subs",
        "stacked_masters"
      ],
      "description": "What contributors submit: calibrated subs, or masters they stack themselves."
    },
    "master_rules": {
      "$ref": "MasterRules.schema.json",
      "description": "Rules for stacked masters. Required when `deliverable` is `stacked_masters`."
    },
    "external_delivery": {
      "$ref": "ExternalDelivery.schema.json",
      "description": "Present when the project accepts files shared outside the API."
    },
    "extensions": {
      "type": "object",
      "unevaluatedProperties": {},
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    }
  },
  "description": "What the project needs. Owners set it with the server's own tools.",
  "allOf": [
    {
      "if": {
        "properties": {
          "deliverable": {
            "const": "stacked_masters"
          }
        }
      },
      "then": {
        "required": [
          "master_rules"
        ]
      },
      "else": {
        "not": {
          "required": [
            "master_rules"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
