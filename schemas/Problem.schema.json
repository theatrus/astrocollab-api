{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Problem.schema.json",
  "title": "Problem",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "code",
    "detail",
    "request_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "$ref": "Text.schema.json"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "$ref": "Code.schema.json"
    },
    "detail": {
      "$ref": "Text.schema.json"
    },
    "request_id": {
      "$ref": "Uuid.schema.json"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "$ref": "Text.schema.json"
          },
          "code": {
            "$ref": "Text.schema.json"
          }
        },
        "required": [
          "pointer",
          "code"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "additionalProperties": false
}
