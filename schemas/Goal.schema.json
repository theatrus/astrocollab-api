{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/Goal.schema.json",
  "title": "Goal",
  "type": "object",
  "properties": {
    "accepted_frames": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_integration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "anyOf": [
    {
      "required": [
        "accepted_frames"
      ]
    },
    {
      "required": [
        "accepted_integration_seconds"
      ]
    }
  ],
  "additionalProperties": false
}
