{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/EquipmentPage.schema.json",
  "title": "EquipmentPage",
  "type": "object",
  "required": [
    "items",
    "next_cursor"
  ],
