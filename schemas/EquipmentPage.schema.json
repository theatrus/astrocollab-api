    "items": {
      "type": "array",
      "items": {
        "$ref": "Equipment.schema.json"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "maxLength": 4096
    }
  },
  "additionalProperties": false
}
