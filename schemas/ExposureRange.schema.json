{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrocollabapi.com/schemas/ExposureRange.schema.json",
  "title": "ExposureRange",
  "type": "object",
  "required": [
    "min_seconds",
    "max_seconds"
  ],
  "properties": {
    "min_seconds": {
      "type": "number",
      "maximum": 86400,
      "exclusiveMinimum": 0
    },
    "max_seconds": {
      "type": "number",
      "maximum": 86400,
      "exclusiveMinimum": 0
    }
  },
  "description": "Server MUST enforce min_seconds <= max_seconds.",
  "additionalProperties": false
}
